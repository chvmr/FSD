<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Product Form</title>
</head>
<body>
    <h1><%= product ? "Update Product" : "Add Product" %></h1>

    <form
        action="<%= product ? '/update-product/' + product._id : '/add-product' %>"
        method="POST"
    >
        <label>Product Name:</label>
        <input
            type="text"
            name="name"
            value="<%= product ? product.name : '' %>"
            required
        >
        <br><br>

        <label>Description:</label>
        <textarea name="description"><%= product ? product.description || '' : '' %></textarea>
        <br><br>

        <label>Category:</label>
        <input
            type="text"
            name="category"
            value="<%= product ? product.category : '' %>"
            required
        >
        <br><br>

        <label>Price:</label>
        <input
            type="number"
            name="price"
            min="0"
            step="0.01"
            value="<%= product ? product.price : '' %>"
            required
        >
        <br><br>

        <button type="submit">
            <%= product ? "Update Product" : "Add Product" %>
        </button>
    </form>

    <br>
    <a href="/">Go Back to Home</a>
</body>
</html>